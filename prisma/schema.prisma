// Prisma schema for Planet Store Web catalog

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  inStock     Boolean  @default(true)
  imageUrl    String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // "admin" has full access; "input" is restricted to category/product CRUD.
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  title       String?
  description String?
  format      String // "9:16" | "4:5"
  videoUrl    String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([format])
  @@index([sortOrder])
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Singleton row (id = "settings") holding site-wide admin-configurable settings.
model StoreSettings {
  id               String   @id @default("settings")
  googleMapsEmbed  String?
  updatedAt        DateTime @updatedAt
}

// Singleton row (id = "special-edition") for the editable premium landing page.
model SpecialEditionPage {
  id          String   @id @default("special-edition")
  title       String
  eyebrow     String?
  description String?
  heroImageUrl String?
  published   Boolean  @default(false)
  contentJson String   @default("[]")
  updatedAt   DateTime @updatedAt
}
